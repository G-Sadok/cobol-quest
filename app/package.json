{
  "name": "cobol-quest",
  "private": true,
  "version": "1.0.0",
  "description": "COBOL QUEST - Operation Marcel : campus virtuel hors-ligne de la CGBA",
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "sync:corpus": "node scripts/sync-corpus.mjs",
    "predev": "npm run sync:corpus",
    "dev": "vite",
    "electron:dev": "wait-on tcp:127.0.0.1:5173 && CQ_URL_DEV=http://localhost:5173 electron .",
    "dev:app": "concurrently -k -n vite,electron -c green,cyan \"npm run dev\" \"npm run electron:dev\"",
    "prebuild": "npm run sync:corpus",
    "build": "vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "icon": "bash scripts/make-icon.sh",
    "predist:mac": "npm run icon",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "build": {
    "appId": "cgba.cobolquest",
    "productName": "COBOL Quest",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "afterPack": "scripts/signature-adhoc.cjs",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.education",
      "icon": "build/icon.icns",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "darkModeSupport": true
    },
    "dmg": {
      "title": "COBOL Quest"
    }
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "vite": "^6.0.7",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  }
}
